# Formulario de contacto — envío por email (src/app/api/contacto/route.ts)
#
# Copiar este archivo a `.env.local` para desarrollo y cargar las mismas
# variables en el panel del hosting (Vercel → Settings → Environment Variables)
# para producción. `.env.local` está ignorado por git: la API key nunca se
# commitea ni llega al bundle del cliente.

# Obligatoria. API key de Resend → https://resend.com/api-keys
# Sin esta variable el formulario responde 503 y ofrece WhatsApp.
RESEND_API_KEY=

# Destinatario de las consultas. Por defecto usa site.email.
CONTACTO_TO=info@cuidadosespecialesensalud.com

# Remitente. Debe ser un dominio verificado en Resend
# (https://resend.com/domains). Para probar sin verificar dominio se puede
# usar el remitente de prueba: Helfen <onboarding@resend.dev>
CONTACTO_FROM=Helfen <contacto@helfensalud.com>
